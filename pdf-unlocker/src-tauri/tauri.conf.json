{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF解锁工具",
  "version": "1.0.0",
  "identifier": "com.heyin.pdfunlock",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDF 权限解锁工具",
        "width": 920,
        "height": 700,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico"],
    "resources": {
      "bin/qpdf": "qpdf/"
    }
  }
}
